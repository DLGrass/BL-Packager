{
  "name": "bl-packager",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency sb3 -> single-file HTML packager, modeled on TurboWarp/packager, with a faster asset-loading path.",
  "type": "commonjs",
  "main": "src/lib/index.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "node .githooks/install.js",
    "pack:html": "node src/pack.js",
    "pack:exe": "node src/pack-exe.js",
    "pack:app": "node src/pack-app.js",
    "pack:mac": "node src/pack-app.js --target macos",
    "pack:linux": "node src/pack-app.js --target linux",
    "pack:android": "node src/pack-app.js --target android",
    "ui": "node ui/server.js",
    "build:site": "node src/build-site.js",
    "make-project": "node bench/make-project.js",
    "bench": "node bench/run.js",
    "ui-check": "node bench/ui-check.js",
    "test": "node test/run.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
